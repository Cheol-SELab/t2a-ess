{
  "text2activity_extraction_model": {
    "model_id": "Q_GOLD",
    "title": "Cold-storage logistics center refrigeration unit failure response",
    "extraction_schema": "T2A-ESS",
    "generation_mode": "manual_development_reference",
    "source_units": [
      {
        "source_unit_id": "P1",
        "unit_type": "paragraph",
        "text": "The cold-storage logistics center operations system consists of a warehouse management system (WMS), 3 refrigeration units, 40 temperature sensors, a door controller, and an emergency generator. The temperature sensors measure the freezer room temperature every 5 min."
      },
      {
        "source_unit_id": "P2",
        "unit_type": "paragraph",
        "text": "Externally, there are the refrigeration unit manufacturer's service center and the shipper; facility operation is handled by the facility manager, and inventory management by the logistics manager."
      },
      {
        "source_unit_id": "P3",
        "unit_type": "paragraph",
        "text": "At 2:00 a.m., when Refrigeration Unit 2 stops due to compressor overheating, the WMS detects the refrigeration unit stop and sends an alarm to the facility manager."
      },
      {
        "source_unit_id": "P4",
        "unit_type": "paragraph",
        "text": "The facility manager raises the output of Refrigeration Units 1 and 3 to maximum and requests a repair from the refrigeration unit manufacturer's service center."
      },
      {
        "source_unit_id": "P5",
        "unit_type": "paragraph",
        "text": "When the freezer room temperature rises above -18 °C, the WMS restricts freezer room access through the door controller. At 3:00 a.m., when the freezer room temperature is measured at -17 °C, the WMS restricts freezer room access."
      },
      {
        "source_unit_id": "P6",
        "unit_type": "paragraph",
        "text": "While access is restricted, the logistics manager moves the cargo scheduled for shipment to the backup freezer room and notifies the shipper of the shipment delay. The two tasks proceed simultaneously."
      },
      {
        "source_unit_id": "P7",
        "unit_type": "paragraph",
        "text": "When the freezer room temperature rises above -15 °C, the logistics manager delivers the cargo temperature records to the shipper. On this day, the temperature did not rise to -15 °C, so the records were not delivered."
      },
      {
        "source_unit_id": "P8",
        "unit_type": "paragraph",
        "text": "At 5:00 a.m., the service center replaces the compressor cooling fan and restarts Refrigeration Unit 2."
      },
      {
        "source_unit_id": "P9",
        "unit_type": "paragraph",
        "text": "When Refrigeration Unit 2 is restarted, the facility manager returns the output of Refrigeration Units 1 and 3 to normal."
      },
      {
        "source_unit_id": "P10",
        "unit_type": "paragraph",
        "text": "At 6:00 a.m., when the freezer room temperature recovers to -20 °C, the WMS lifts the freezer room access restriction."
      },
      {
        "source_unit_id": "P11",
        "unit_type": "paragraph",
        "text": "The logistics manager returns the cargo in the backup freezer room to its original locations one after another and resumes shipment."
      },
      {
        "source_unit_id": "P12",
        "unit_type": "paragraph",
        "text": "The facility manager compiles the failure circumstances and reports them to the shipper."
      },
      {
        "source_unit_id": "P13",
        "unit_type": "paragraph",
        "text": "The goal of this scenario is to keep the freezer room temperature at -15 °C or less without cargo damage."
      }
    ],
