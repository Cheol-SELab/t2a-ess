"NGHE 72-hour autonomous construction::E5 Recovery and mission completion::Resume construction, return to Level 4" [shape=box, style="rounded", margin=0.04, label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="7" COLOR="#777777">Lv.2</FONT></TD><TD ALIGN="RIGHT"><FONT POINT-SIZE="7" COLOR="#777777">#Function</FONT></TD></TR><TR><TD COLSPAN="2"><B>Resume construction,<BR/>return to Level 4</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="8"><I>Remote supervisor, Unmanned equipment fleet</I></FONT></TD></TR></TABLE>>];
