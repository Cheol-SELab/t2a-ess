digraph G { rankdir=LR; nodesep=0.25; ranksep=0.35; bgcolor="white";
node [fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#555555"];
label=<<B>Lv.0 MUM-T attack operation under EW</B>>; labelloc=t; labeljust=l; fontname="Arial"; fontsize=12;
"s" [shape=circle, style=filled, fillcolor=black, label="", width=0.18];
"d" [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.13];
"e0" [shape=box, style="rounded", penwidth=1.3, label=<E1 Preparation under<BR/>normal comms>];
"e1" [shape=box, style="rounded", penwidth=1.3, label=<E2 Observation post<BR/>and FPV threat>];
"e2" [shape=box, style="rounded", penwidth=1.3, label=<E3 EW jamming and<BR/>comms degradation>];
"e3" [shape=box, style="rounded", penwidth=1.3, label=<E4 Comms recovery<BR/>and attack<BR/>resumption>];
"s" -> "e0";
"e0" -> "e1";
"e1" -> "e2";
"e2" -> "e3";
"e3" -> "d";
"e2" -> "e3" [style=dashed, color="#1f5fa8", fontcolor="#1f5fa8", label=<Summary track data>, constraint=false];
}