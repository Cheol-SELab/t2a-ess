digraph G { rankdir=LR; nodesep=0.25; ranksep=0.35; bgcolor="white";
node [fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, color="#555555"];
label=<<B>Lv.0 NGHE 72-hour autonomous construction</B>>; labelloc=t; labeljust=l; fontname="Arial"; fontsize=12;
"s" [shape=circle, style=filled, fillcolor=black, label="", width=0.18];
"d" [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.13];
"e0" [shape=box, style="rounded", penwidth=1.3, label=<E1 Site setup and<BR/>Level 3 start>];
"e1" [shape=box, style="rounded", penwidth=1.3, label=<E2 Level 4<BR/>autonomous<BR/>production>];
"e2" [shape=box, style="rounded", penwidth=1.3, label=<E3 Fog and cyber<BR/>threat response>];
"e3" [shape=box, style="rounded", penwidth=1.3, label=<E4 Heavy rain and<BR/>work stop>];
"e4" [shape=box, style="rounded", penwidth=1.3, label=<E5 Recovery and<BR/>mission completion>];
"s" -> "e0";
"e0" -> "e1";
"e1" -> "e2";
"e2" -> "e3";
"e3" -> "e4";
